# ── Shareability Service — environment template ─────────────────────────────
# Copy to `.env` (auto-loaded by Bun) and fill in real values.

# --- Service ---
PORT=3004

# --- Mongo (single DB per service convention) ---
DATABASE_URL=mongodb://localhost:27017
# TODO: confirm the official shareability DB name once the spec arrives
DATABASE_NAME=Traderverse-Shareability

# --- LinkedIn OAuth connect ---
# client_id / client_secret from your LinkedIn app
LINKEDIN_APP_API_KEY=
LINKEDIN_APP_SECRET_KEY=
# App base URL + callback path — redirect_uri is APP_URL + LINKEDIN_CALLBACK_URL (concatenated)
APP_URL=
LINKEDIN_CALLBACK_URL=
# Authorization base URL (default https://www.linkedin.com/oauth/v2/authorization)
LINKEDIN_AUTH_URL=

# --- X (Twitter) OAuth connect (GET /x/redirect-url + POST /x/user-info) ---
# client_id / client_secret from your X developer app (Basic auth on token exchange)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Callback path — appended to APP_URL (plain concatenation) as redirect_uri
TWITTER_CALLBACK_URL=
# Authorization base URL (default https://x.com/i/oauth2/authorize)
TWITTER_AUTH_URL=
# Token-exchange POST URL (default https://api.twitter.com/2/oauth2/token)
TWITTER_GET_TOKEN_API=

# --- Telegram OAuth connect (GET /telegram/redirect-url + GET /telegram/user-info) ---
# Bot token "<botId>:<secret>" from BotFather (used as bot_id in the auth URL and Bot API auth)
TELEGRAM_BOT_TOKEN=

# --- Facebook OAuth connect (GET /facebook/redirect-url + POST /facebook/user-info) ---
# App id / secret from your Facebook app
FB_APP_ID=
FB_APP_SECRET=
# Callback path — appended to APP_URL (plain concatenation) as redirect_uri
FB_CALLBACK_URL=
# Authorization base URL (e.g. https://www.facebook.com/v19.0/dialog/oauth)
FB_AUTH_URL=
# Accounts endpoint (e.g. https://graph.facebook.com/v19.0/me/accounts) — EXACT env name kept
Facebook_GET_ACCOUNTS=

# --- Social username verification (GET /verify-username) ---
# facebook (axios, cookie-based)
FACEBOOK_COOKIE_C_USER=
FACEBOOK_COOKIE_XS=
# reddit (OAuth client-credentials)
REDDIT_APP_ID=
REDDIT_APP_SECRET=
# instagram (puppeteer real-login)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- Discord (GET /discord/guilds + GET /connect-guild) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Callback path — appended to APP_URL (plain concatenation) as redirect_uri
DISCORD_CALLBACK_URL=
# Bot invite permission bitfield (integer, parsed with parseInt) for /connect-guild
DISCORD_PERMISSION=
